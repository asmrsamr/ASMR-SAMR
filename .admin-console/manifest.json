  "gaps": [
    {
      "id": "users-route-profile-scope",
      "severity": "high",
      "description": "The hidden users route can be opened directly by non-admin roles with customers.read, and profiles RLS permits those roles to select all profiles.",
      "status": "fixed",
      "rationale": "Navigation hiding is not authorization; this can expose staff and customer profile data beyond the intended role boundary.",
      "evidence": [
        "website/admin-dashboard.js:437",
        "website/admin-dashboard.js:2527",
        "website/admin-dashboard.js:5370",
        "supabase/migrations/20260717074706_admin_security_and_operations.sql:1052",
        "supabase/migrations/20260717074551_extend_admin_operations.sql:43"
      ]
    },
    {
      "id": "export-audit-fail-open",
      "severity": "high",
      "description": "Dashboard exports are downloaded before the audit event is attempted, and audit insertion failures are swallowed.",
      "status": "fixed",
      "rationale": "Regulated exports must be auditable and should fail closed when the audit record cannot be persisted.",
      "evidence": [
        "website/admin-dashboard.js:6389",
        "website/admin-dashboard.js:6407"
      ]
    },
    {
      "id": "csv-formula-injection",
      "severity": "high",
      "description": "CSV export escaping does not neutralize cells beginning with spreadsheet formula control characters.",
      "status": "fixed",
      "rationale": "User-controlled names, descriptions, notes, and contact fields can become executable formulas when an export is opened in spreadsheet software.",
      "evidence": [
        "website/admin-dashboard.js:6191"
      ]
    },
    {
      "id": "dashboard-errors-masked-as-empty",
      "severity": "medium",
      "description": "safeRows converts all request failures into empty arrays across operational dashboards.",
      "status": "fixed",
      "rationale": "Authorization, schema, and availability failures can be misrepresented as zero sales, zero stock, or no records instead of a degraded/error state.",
      "evidence": [
        "website/admin-dashboard.js:2563",
        "website/admin-dashboard.js:2601"
      ]
    },
    {
      "id": "modal-keyboard-contract",
      "severity": "medium",
      "description": "Admin modals set initial focus but do not trap focus, restore the opener, or implement Escape-to-close behavior.",
      "status": "fixed",
      "rationale": "Critical edit and confirmation workflows are not fully keyboard operable against the WCAG 2.2 AA target.",
      "evidence": [
        "website/admin-dashboard.js:761",
        "website/admin-dashboard.js:777"
      ]
    }
  ],
